---
import { getAsciiAssetUrls, readPublicTextAsset } from '../lib/ascii-assets';

interface Props {
  manifestUrl?: string;
  framesUrl?: string;
  posterUrl?: string;
}

const defaults = getAsciiAssetUrls();
const {
  manifestUrl = defaults.manifestUrl,
  framesUrl = defaults.framesUrl,
  posterUrl = defaults.posterUrl
} = Astro.props as Props;
const posterText = readPublicTextAsset(posterUrl);
---
<div
  class="ascii-bg"
  data-ascii-bg
  data-manifest-url={manifestUrl}
  data-frames-url={framesUrl}
  data-poster-url={posterUrl}
  aria-hidden="true"
>
  <canvas class="ascii-bg__canvas" hidden></canvas>
  <pre class="ascii-bg__poster">{posterText}</pre>
</div>

<script>
  import { initAsciiPlayer } from './ascii-player';

  document.querySelectorAll('[data-ascii-bg]').forEach((node) => {
    if (!(node instanceof HTMLElement)) return;
    const manifestUrl = node.dataset.manifestUrl ?? '/media/ascii-bike/manifest.json';
    const framesUrl = node.dataset.framesUrl ?? '/media/ascii-bike/frames.bin';
    const posterUrl = node.dataset.posterUrl ?? '/media/ascii-bike/poster.txt';

    initAsciiPlayer({
      container: node,
      manifestUrl,
      framesUrl,
      posterUrl,
      loop: true,
      autoplay: true
    });
  });
</script>
