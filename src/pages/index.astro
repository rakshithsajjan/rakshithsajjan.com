---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Search from '../components/Search.astro';
import AsciiBackground from '../components/AsciiBackground.astro';
import { getAsciiAssetUrls } from '../lib/ascii-assets';

const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const posts = Object.entries(postModules).map(([file, module]) => {
  const slug = file.split('/').pop().replace(/\.md$/, '');
  return {
    slug,
    url: module.url ?? `/blog/${slug}`,
    frontmatter: module.frontmatter ?? module.default?.frontmatter,
    component: module.default
  };
});

const sortedPosts = posts.sort((a, b) => {
  return new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime();
});

const hero = sortedPosts[0];
const asciiAssets = getAsciiAssetUrls();
---
<BaseLayout title="Rakshith Sajjan" description="Experiments and writing from Rakshith Sajjan.">
  <Fragment slot="head">
    <link rel="preload" href={asciiAssets.manifestUrl} as="fetch" type="application/json" crossorigin="anonymous" />
    <link rel="preload" href={asciiAssets.framesUrl} as="fetch" type="application/octet-stream" crossorigin="anonymous" />
  </Fragment>
  <main>
    <section class="hero">
      <AsciiBackground
        manifestUrl={asciiAssets.manifestUrl}
        framesUrl={asciiAssets.framesUrl}
        posterUrl={asciiAssets.posterUrl}
      />
      <div class="overlay"></div>
      <div class="content">
        <h1>Rakshith Sajjan</h1>
        <p>Writing, tinkering, and building in public. This site is home for long-form thoughts, experiments, and a bit of personality.</p>
        {hero ? (
          <a class="hero-link" href={hero.url} aria-label={`Read latest post ${hero.frontmatter.title}`}>
            Latest: {hero.frontmatter.title}
          </a>
        ) : null}
      </div>
    </section>

    <div class="page-grid">
      <div>
        <h2>Latest posts</h2>
        <div class="posts">
          {sortedPosts.map((post) => (
            <PostCard post={post} key={post.slug} />
          ))}
        </div>
      </div>
      <aside>
        <Search />
      </aside>
    </div>
  </main>
</BaseLayout>
