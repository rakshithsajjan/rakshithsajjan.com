---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

interface PostModule {
  url?: string;
  frontmatter: any;
  default: any;
}

const postModules = import.meta.glob<PostModule>('../../content/blog/*.md', { eager: true });
const posts = Object.entries(postModules).map(([file, module]) => {
  const slug = file.split('/').pop()?.replace(/\.md$/, '') || '';
  return {
    slug,
    url: module.url ?? `/blog/${slug}`,
    frontmatter: module.frontmatter ?? module.default?.frontmatter,
    component: module.default
  };
});

const sorted = posts.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
---
<BaseLayout title="Blog" description="Long-form posts from Rakshith Sajjan.">
  <main class="page-grid">
    <div>
      <h1>Writing</h1>
      <p>Updated as ideas show up in the drafts folder.</p>
      {sorted.map((post) => (
        <PostCard post={post} key={post.slug} />
      ))}
    </div>
  </main>
</BaseLayout>
